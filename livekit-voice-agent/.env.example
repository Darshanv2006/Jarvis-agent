# LiveKit Cloud Project Credentials (from cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# OpenAI API Key (used for STT, LLM gpt-4o-mini, and TTS alloy voice)
OPENAI_API_KEY=sk-proj-...

# Optional: Mission Control Next.js API endpoint (defaults to http://localhost:3000/api/plan)
API_BASE_URL=http://localhost:3000/api/plan
